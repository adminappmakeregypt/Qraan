rules_version = '2';
// ===================== Qraan — قواعد الحماية =====================
// المدير: كل الصلاحيات.  المحفظ: يرى طلابه ومحاضراته فقط، ويسجل الحضور.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/qraan_admins/$(request.auth.uid)); }
    function mine(d) { return signedIn() && d.teacherUid == request.auth.uid; }
    function supervises(d) { return signedIn() && d.supervisorUid == request.auth.uid; }

    // إعداد أول مرة: يتم مرة واحدة فقط
    match /qraan_config/setup {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /qraan_admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/qraan_config/setup)
        && getAfter(/databases/$(database)/documents/qraan_config/setup).data.adminUid == uid;
      allow update, delete: if false;
    }

    match /qraan_settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /qraan_teachers/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid) || supervises(resource.data);
      allow write: if isAdmin();
    }

    // المشرفات
    match /qraan_supervisors/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    // تقييم المشرفة للمحفظ
    match /qraan_teacherEvals/{id} {
      allow read: if isAdmin() || supervises(resource.data);
      allow create: if isAdmin() || (supervises(request.resource.data)
        && get(/databases/$(database)/documents/qraan_teachers/$(request.resource.data.teacherId)).data.supervisorUid == request.auth.uid);
      allow update, delete: if isAdmin() || supervises(resource.data);
    }

    match /qraan_students/{id} {
      allow read: if isAdmin() || mine(resource.data) || supervises(resource.data);
      allow create, delete: if isAdmin();
      // المحفظ يغيّر فقط عدادات الحضور والرصيد (± محاضرة واحدة في كل مرة)
      allow update: if isAdmin() || (mine(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining', 'attended', 'absent', 'excused', 'status', 'expiredAt'])
        && request.resource.data.remaining >= resource.data.remaining - 1
        && request.resource.data.remaining <= resource.data.remaining + 1);
    }

    match /qraan_reports/{id} {
      allow read: if isAdmin() || mine(resource.data) || supervises(resource.data);
      allow create: if isAdmin() || (mine(request.resource.data)
        && get(/databases/$(database)/documents/qraan_students/$(request.resource.data.studentId)).data.teacherUid == request.auth.uid);
      allow update: if isAdmin();
      // المحفظ يقدر يتراجع خلال 24 ساعة فقط
      allow delete: if isAdmin() || (mine(resource.data) && request.time.toMillis() - resource.data.createdAt < 86400000);
    }

    // سجل البيانات: صفحة عامة — أي حد يقدر يرسل (إنشاء فقط)، والمدير بس اللي يقرأ ويعدّل
    match /qraan_intake/{id} {
      allow create: if request.resource.data.keys().hasOnly(['id', 'createdAt', 'status', 'version', 'teacher', 'students'])
        && request.resource.data.id == id
        && request.resource.data.status == 'new'
        && request.resource.data.teacher is map
        && request.resource.data.teacher.name is string
        && request.resource.data.teacher.name.size() > 1 && request.resource.data.teacher.name.size() <= 60
        && request.resource.data.students is list
        && request.resource.data.students.size() >= 1 && request.resource.data.students.size() <= 80;
      allow read, update, delete: if isAdmin();
    }

    match /qraan_outbox/{id} {
      allow read, update: if isAdmin();
      allow create: if isAdmin() || (signedIn() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.kind in ['renew', 'eval'] && request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid && resource.data.status == 'pending');
    }
  }
}
